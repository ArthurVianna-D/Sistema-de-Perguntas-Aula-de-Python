# Função com mais lógica
def calcular_imc(peso, altura):
    imc = peso / (altura ** 2)
    return imc

imc = calcular_imc(peso, altura)
print(f'IMC: {imc:.2f}')

# Condicional com múltiplas verificações
if imc < 18.5:
    print('Abaixo do peso')
elif imc < 25:
    print('Peso normal')
elif imc < 30:
    print('Sobrepeso')
else:
    print('Obesidade')

