# Variáveis são usadas para salvar algo na memória do computador.
# PEP8: inicie variáveis com letras minúsculas, pode usar
# números e underline _.
# O sinal de = é o operador de atribuição. Ele é usado para
# atribuir um valor a um nome (variável).
# Uso: nome_variavel = expressão

# nome_completo = 'Arthur Vianna'
# soma_dois_mais_dois = 2 + 2
# int_um = bool('1')
# print(int_um, type(int_um))
# print(nome_completo, soma_dois_mais_dois)

nome = 'Arthur'
idade = 17
maior_de_idade = idade >= 18
print('Nome:', nome, 'Idade:', idade)
print('É maior?', maior_de_idade)

# Podemos alterar o valor de uma variável ao longo do programa
idade = idade + 1  # Arthur fez aniversário
print('Nova idade:', idade)

# Strings podem ser concatenadas (juntadas)
sobrenome = 'Vianna'
nome_completo = nome + ' ' + sobrenome
print('Nome completo:', nome_completo)

# Também podemos usar f-strings (forma mais moderna)
print(f'Olá, meu nome é {nome_completo} e eu tenho {idade} anos.')

# Tipos de dados
# str -> texto
# int -> número inteiro
# float -> número com casas decimais
# bool -> verdadeiro ou falso

altura = 1.75  # float
peso = 70      # int
print('Altura:', altura, 'Tipo:', type(altura))
print('Peso:', peso, 'Tipo:', type(peso))

# Operações matemáticas básicas
soma = 10 + 5
subtracao = 10 - 5
multiplicacao = 10 * 5
divisao = 10 / 5

print('Soma:', soma)
print('Subtração:', subtracao)
print('Multiplicação:', multiplicacao)
print('Divisão:', divisao)

# Operadores de comparação retornam booleanos (True ou False)
print('Idade é maior que 18?', idade > 18)
print('Idade é igual a 18?', idade == 18)
print('Idade é diferente de 18?', idade != 18)

# Podemos usar condicionais para tomar decisões
if idade >= 18:
    print('Pode tirar carteira de motorista.')
else:
    print('Ainda não pode tirar carteira.')

# Listas (arrays em outras linguagens)
frutas = ['maçã', 'banana', 'laranja']
print('Lista de frutas:', frutas)

# Acessando elementos da lista
print('Primeira fruta:', frutas[0])
print('Última fruta:', frutas[-1])

# Adicionando elementos na lista
frutas.append('uva')
print('Lista atualizada:', frutas)

# Laços de repetição (for)
for fruta in frutas:
    print('Eu gosto de:', fruta)

# While (repete enquanto a condição for verdadeira)
contador = 0
while contador < 3:
    print('Contador:', contador)
    contador += 1

# Funções (blocos reutilizáveis de código)
def saudacao(nome):
    return f'Olá, {nome}! Seja bem-vindo.'

mensagem = saudacao(nome)
print(mensagem)

# Entrada de dados do usuário (comentado pra não travar execução automática)
nome_usuario = input('Digite seu nome: ')
print(f'Prazer em te conhecer, {nome_usuario}!')

# Trabalhando com dicionários (estrutura chave:valor)
pessoa = {
    'nome': nome_completo,
    'idade': idade,
    'altura': altura,
    'maior_de_idade': maior_de_idade
}

print('Dicionário pessoa:', pessoa)
print('Nome no dicionário:', pessoa['nome'])

# Podemos adicionar ou alterar valores no dicionário
pessoa['profissao'] = 'Estudante'
pessoa['idade'] = idade  # atualizando idade
print('Dicionário atualizado:', pessoa)
